---
import ComunaRanking from "../components/ComunaRanking.astro";
import PriceBoard from "../components/PriceBoard.astro";
import RegionMap from "../components/RegionMap.astro";
import Layout from "../layouts/Layout.astro";

const selectedFuel = "95";
---

<Layout>
  <h1 class="max-w-prose font-display text-3xl leading-tight font-bold sm:text-4xl">
    Dónde cargar más barato en la Región Metropolitana
  </h1>

  <div
    data-fuel={selectedFuel}
    class="mt-6 grid gap-8 lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-start"
  >
    <RegionMap fuel={selectedFuel} />
    <div class="space-y-8">
      <PriceBoard selected={selectedFuel} />
      <ComunaRanking />
    </div>
  </div>
</Layout>

<script>
  import "../scripts/fuel-explorer";
</script>
