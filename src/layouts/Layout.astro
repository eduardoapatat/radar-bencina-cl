---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import pricesMeta from "../data/prices.meta.json";
import "../styles/global.css";

const isMockData = pricesMeta.source === "mock";

interface Props {
  title?: string;
  description?: string;
  // Area shown next to the site name: "Chile" or the region name
  area?: string;
}

const {
  title = "Radar Bencina",
  description = "Precios de combustible en Chile, comuna por comuna, con datos oficiales de la CNE.",
  area = "Chile",
} = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1b1d20" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <Font cssVariable="--font-barlow" preload />
    <Font cssVariable="--font-barlow-condensed" preload />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="flex min-h-dvh flex-col">
    <header class="border-b border-lane">
      <div class="mx-auto flex max-w-6xl items-baseline justify-between px-4 py-3">
        <a href="/" class="font-display text-xl font-bold">
          Radar Bencina
        </a>
        <span class="text-sm text-dust">{area}</span>
      </div>
    </header>

    {isMockData && (
      <p class="bg-led px-4 py-2 text-center text-sm font-semibold text-asphalt">
        Datos de prueba: estos precios y estaciones no son reales.
      </p>
    )}

    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-6">
      <slot />
    </main>

    <footer class="border-t border-lane text-sm text-dust">
      <div class="mx-auto max-w-6xl space-y-1 px-4 py-4">
        <p>
          Precios: Comisión Nacional de Energía, Bencina en Línea. Cada estación informa sus propios
          precios.
        </p>
        <p>Límites comunales: Biblioteca del Congreso Nacional.</p>
      </div>
    </footer>
  </body>
</html>
