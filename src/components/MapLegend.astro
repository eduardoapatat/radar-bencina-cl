---
// Legend for the diverging map scale, with the reference price of the selected fuel.
import { CLASS_LABELS, FUEL_LABELS, PRICE_CLASSES, formatClp } from "../lib/prices";
import { FUELS, type Fuel } from "../lib/schema";

interface Props {
  // e.g. "Diferencia con el promedio nacional"
  text: string;
  references: Record<Fuel, number | undefined>;
}

const { text, references } = Astro.props;
---

<section aria-label="Leyenda del mapa" class="space-y-2">
  <p class="text-center text-sm text-dust">
    {text}
    {FUELS.map((f) => (
      <span data-for-fuel={f}>
        {references[f] !== undefined && ` (${formatClp(references[f])} la ${FUEL_LABELS[f]})`}
      </span>
    ))}
  </p>
  <ul class="flex flex-wrap justify-center gap-x-4 gap-y-1 text-sm">
    {PRICE_CLASSES.map((c) => (
      <li class="flex items-center gap-2">
        <span class="size-3 shrink-0 rounded-sm bg-(--fill)" data-class={c} />
        {CLASS_LABELS[c]}
      </li>
    ))}
  </ul>
</section>
