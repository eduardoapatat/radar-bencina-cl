---
// Gas-station price board: one row per fuel with its lowest price in the region.
// Each row is also the fuel selector for the map and the ranking.
import { FUEL_LABELS, formatClp } from "../lib/prices";
import { getRegionData } from "../lib/region";
import { FUELS, type Fuel } from "../lib/schema";

interface Props {
  selected: Fuel;
}

const { selected } = Astro.props;
const { cheapestStation } = await getRegionData();
---

<section aria-labelledby="board-title" class="w-full max-w-sm">
  <h2 id="board-title" class="font-display text-lg font-semibold text-dust">
    Precio más bajo por litro hoy
  </h2>

  <ul class="mt-2 overflow-hidden rounded-t-xl border border-lane bg-curb">
    {FUELS.map((fuel) => {
      const best = cheapestStation(fuel);
      return (
        <li class="border-b border-lane last:border-b-0">
          <button
            type="button"
            class="group flex w-full items-center gap-4 px-4 py-3 text-left hover:bg-lane/40"
            data-fuel-option={fuel}
            aria-pressed={fuel === selected ? "true" : "false"}
          >
            <span class="sr-only">Ver el mapa de</span>
            <span class="grid size-12 shrink-0 place-items-center rounded-md border-2 border-lane font-display text-2xl font-bold text-dust group-aria-pressed:border-sign group-aria-pressed:bg-sign group-aria-pressed:text-paint">
              {fuel === "diesel" ? "D" : FUEL_LABELS[fuel]}
            </span>

            <span class="relative font-display text-5xl leading-none font-bold tabular-nums">
              <span aria-hidden="true" class="text-led-off">
                8.888
              </span>
              <span class="absolute inset-0 text-led">
                {best ? formatClp(best.price).slice(1) : ""}
              </span>
            </span>

            <span class="ml-auto text-right text-sm text-dust">
              {best?.comuna ?? "Sin datos aún"}
            </span>
          </button>
        </li>
      );
    })}
  </ul>
</section>
