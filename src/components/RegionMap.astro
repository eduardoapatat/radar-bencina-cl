---
// RM choropleth rendered entirely at build time: no client JS needed to see it.
// Everything that depends on the fuel is rendered for all four fuels; the page's
// `data-fuel` root attribute decides what shows (see global.css), and the fuel
// selector script only swaps each comuna's `data-class`. Each comuna is a link
// to its page, so the map also works with the keyboard and without JS.
import { CLASS_LABELS, FUEL_LABELS, PRICE_CLASSES, formatClp } from "../lib/prices";
import { getRegionData } from "../lib/region";
import { comunaHref } from "../lib/slug";
import type { RegionInfo } from "../lib/regions";
import { FUELS, type Fuel } from "../lib/schema";

interface Props {
  region: RegionInfo;
  fuel: Fuel;
}

const { region, fuel } = Astro.props;
const { stats, medians, map, classFor, ranking } = await getRegionData(region.code);
const { width, height, shapes } = map;
const shapeByCut = new Map(shapes.map((s) => [s.cut, s]));

// One outline per cheapest comuna, shared by every fuel it wins: the same comuna often
// wins several fuels, and southern comuna outlines are large.
const fuelsByCheapest = new Map<string, Fuel[]>();
for (const f of FUELS) {
  const cut = ranking(f)[0]?.cut;
  if (cut && shapeByCut.has(cut))
    fuelsByCheapest.set(cut, [...(fuelsByCheapest.get(cut) ?? []), f]);
}
const cheapestOutlines = [...fuelsByCheapest].map(([cut, fuels]) => ({
  cheapest: shapeByCut.get(cut),
  fuels,
}));

const perFuelAttrs = (cut: string) =>
  Object.fromEntries(
    FUELS.flatMap((f) => {
      const s = stats.get(cut)?.[f];
      return [
        [`data-class-${f}`, classFor(cut, f)],
        [`data-median-${f}`, s?.median ?? ""],
        [`data-count-${f}`, s?.count ?? 0],
      ];
    }),
  );
---

<figure
  class="relative space-y-3"
  data-region-map
  {...Object.fromEntries(FUELS.map((f) => [`data-ref-${f}`, medians[f] ?? ""]))}
>
  <svg
    viewBox={`0 0 ${width} ${height}`}
    class="h-auto w-full"
    role="img"
    aria-labelledby="map-title"
  >
    <title id="map-title">
      Mapa de comunas de {region.label} coloreadas según su precio mediano
    </title>

    {shapes.map((shape) => {
      const fuelStats = stats.get(shape.cut)?.[fuel];
      return (
        <a
          href={comunaHref(region.slug, shape.name)}
          data-comuna-link
          data-cut={shape.cut}
          data-name={shape.name}
          aria-label={`Ver estaciones de ${shape.name}`}
        >
          <path
            d={shape.d}
            class="comuna"
            data-class={classFor(shape.cut, fuel)}
            {...perFuelAttrs(shape.cut)}
          >
            <title>
              {fuelStats
                ? `${shape.name}: mediana ${formatClp(fuelStats.median)}`
                : `${shape.name}: sin datos`}
            </title>
          </path>
        </a>
      );
    })}

    {cheapestOutlines.map(({ cheapest, fuels }) => {
      return (
        cheapest && (
          <g class="pointer-events-none" data-for-fuel={fuels.join(" ")}>
            <path d={cheapest.d} class="cheapest-outline" />
            <text
              x={cheapest.centroid[0]}
              y={cheapest.centroid[1]}
              class="cheapest-label font-display"
              text-anchor="middle"
              dominant-baseline="middle"
            >
              {cheapest.name}
            </text>
          </g>
        )
      );
    })}

    <!-- Hover/tap highlight drawn last: SVG has no z-index, so a stroke on the
         comuna itself gets half-covered by neighbors painted after it. -->
    <path class="highlight-outline invisible" data-map-highlight></path>
  </svg>

  <div
    class="map-tooltip pointer-events-none absolute z-10 hidden w-max max-w-56 rounded-md border border-lane bg-curb px-3 py-2 text-sm"
    data-map-tooltip
    role="status"
  ></div>

  <figcaption class="space-y-2">
    <p class="text-sm text-dust">
      Diferencia con la mediana de la región
      {FUELS.map((f) => (
        <span data-for-fuel={f}>
          {medians[f] !== undefined && ` (${formatClp(medians[f])} la ${FUEL_LABELS[f]})`}
        </span>
      ))}
    </p>
    <ul class="grid grid-cols-2 gap-x-4 gap-y-1 text-sm sm:grid-cols-5">
      {PRICE_CLASSES.map((c) => (
        <li class="flex items-center gap-2">
          <span class="size-3 shrink-0 rounded-sm bg-(--fill)" data-class={c} />
          {CLASS_LABELS[c]}
        </li>
      ))}
    </ul>
  </figcaption>
</figure>

<style>
  .comuna {
    stroke: var(--color-asphalt);
    stroke-width: 1;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    transition: fill 250ms ease-out;
  }

  /* Browsers draw focus on SVG links as a bounding rectangle. The shaped highlight
     (region-map.ts shows it on focus) replaces it; the stroke below is the no-JS fallback. */
  [data-comuna-link]:focus {
    outline: none;
  }
  [data-comuna-link]:focus-visible .comuna {
    stroke: var(--color-paint);
    stroke-width: 2;
  }

  .highlight-outline {
    fill: none;
    stroke: var(--color-paint);
    stroke-width: 2;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .comuna {
      transition: none;
    }
  }

  .comuna {
    fill: var(--fill);
  }

  .cheapest-outline {
    fill: none;
    stroke: var(--color-paint);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  .cheapest-label {
    fill: var(--color-paint);
    font-size: 15px;
    font-weight: 700;
    paint-order: stroke;
    stroke: var(--color-asphalt);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
</style>
